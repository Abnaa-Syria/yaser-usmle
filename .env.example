# انسخ الملف ده لـ .env قبل التشغيل:
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=Yaser USMLE
VITE_SITE_URL=https://yaser-usmle.com
VITE_DEFAULT_LOCALE=ar

# اختياري — روابط التواصل والسوشيال
VITE_CONTACT_EMAIL=info@yaser-usmle.com
VITE_SUPPORT_PHONE=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_LINKEDIN_URL=

# The comprehensive Step 1 demo seed covers these modules.
# Keep frontend and backend feature flags aligned.
VITE_FEATURE_WALLET=true
VITE_FEATURE_COMMUNITY_EVENTS=true
VITE_FEATURE_PUBLIC_INSTRUCTOR_CATALOG=false
VITE_FEATURE_INSTRUCTOR_SELF_SERVICE=false
VITE_FEATURE_PRIVATE_BOOKING=true
VITE_FEATURE_MULTI_INSTRUCTOR=false
